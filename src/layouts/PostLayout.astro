---
import type { MarkdownHeading } from 'astro';
import type { BlogPost } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate, getPostUrl } from '../utils/posts';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  previous?: BlogPost;
  next?: BlogPost;
}

const { post, headings, previous, next } = Astro.props;
const title = `${post.data.title} | Articles`;
---

<BaseLayout title={title} description={post.data.description} bodyClass="subpage-body" ogType="article">
  <main class="subpage-main">
    <article class="article-shell">
      <header class="article-header">
        <a class="back-link" href="/articles/">Back to Articles</a>
        <p class="page-kicker">{post.data.category}</p>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="article-meta">
          <span>{formatDate(post.data.pubDate)}</span>
          {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
          {post.data.series && <span>{post.data.series}</span>}
        </div>
        <TagList tags={post.data.tags} />
      </header>

      <div class="article-grid">
        <div class="prose" data-pagefind-body>
          <slot />
        </div>
        <aside class="article-aside" aria-label="Article navigation">
          {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 0 && (
            <nav class="toc">
              <p class="toc-title">On This Article</p>
              {headings
                .filter((heading) => heading.depth === 2 || heading.depth === 3)
                .map((heading) => (
                  <a class={`toc-link depth-${heading.depth}`} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
            </nav>
          )}
        </aside>
      </div>

      <nav class="article-pagination" aria-label="Adjacent articles">
        {previous ? (
          <a href={getPostUrl(previous)}>
            <span>Previous</span>
            {previous.data.title}
          </a>
        ) : <span></span>}
        {next && (
          <a href={getPostUrl(next)}>
            <span>Next</span>
            {next.data.title}
          </a>
        )}
      </nav>
    </article>
  </main>
</BaseLayout>
